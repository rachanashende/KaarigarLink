# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=4000

# Local PostgreSQL 16 (service postgresql-x64-16, port 5432).
# Replace YOUR_PASSWORD with the postgres password set during install.
# Prisma creates the database automatically on first migrate if it does not exist.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/kaarigarlink_dev?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

BCRYPT_SALT_ROUNDS=10
