# Copy to .env.test. MUST point to a different database than .env (kaarigarlink_test) -
# API tests wipe all tables before each test file.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/kaarigarlink_test?schema=public"
JWT_SECRET="test-secret-at-least-16-characters-long"
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:5173
BCRYPT_SALT_ROUNDS=4
