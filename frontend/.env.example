# Copy to frontend/.env.local (never commit real values). Restart `npm run dev` after changes.

# "mock" (default): in-browser demo data, demo role switcher, no backend needed.
# "live": connects to the Express backend below with real JWT authentication.
VITE_SERVICE_MODE=mock

# Live mode only: the backend API base URL, including /api (no trailing slash).
# The backend must allow this frontend's origin in CORS_ORIGINS (the backend's
# development default already allows http://localhost:5173 and http://127.0.0.1:5173).
VITE_API_BASE_URL=http://localhost:4000/api

# Live mode only: show the four one-click demo login shortcuts. They work only when the
# backend runs in development with ENABLE_DEMO_LOGIN=true; no password or token is stored here.
# Set to "false" to hide them (the backend enforces its own switch regardless).
VITE_DEMO_LOGIN=true
