// M12: documents, audit history and in-app notifications.

enum DocumentKind {
  /// Buyer design references attached to a job.
  DESIGN_FILE
  /// Inspector evidence attached to an order (optionally linked to the submitted inspection).
  INSPECTION_EVIDENCE
}

/// A stored file. Contents live in the storage backend (local disk in development);
/// only metadata is in PostgreSQL. `storageKey` is generated by the server and never
/// derived from the client filename.
model Document {
  id           String       @id @default(cuid())
  kind         DocumentKind
  uploaderId   String
  jobId        String?
  orderId      String?
  inspectionId String?
  /// The client filename, sanitised; display only (never used as a path).
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String       @unique
  sha256       String
  createdAt    DateTime     @default(now())

  uploader   User        @relation("DocumentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  job        Job?        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  order      Order?      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inspection Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([orderId])
  @@index([inspectionId])
}

/// Append-only business audit history. Written inside the business transaction it
/// describes, so a failed operation records nothing. A database trigger rejects
/// UPDATE and DELETE; there is no API to change it. `actorId` is a plain id (no FK)
/// so history survives independently of user rows.
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  /// e.g. ORDER_COMPLETED, QUOTE_SUBMITTED (see docs/API.md for the list).
  action     String
  entityType String
  entityId   String
  /// Set when the event belongs to an order (order-level history) or a job.
  orderId    String?
  jobId      String?
  /// Small, non-sensitive details (statuses, amounts, ids). Never secrets or personal data.
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([orderId, createdAt])
  @@index([jobId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
}

/// In-app notification for one user. `dedupeKey` (event id + user) prevents duplicates.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String
  title      String
  body       String
  entityType String?
  entityId   String?
  /// Frontend path to open, e.g. /buyer/orders/<id>.
  link       String?
  dedupeKey  String    @unique
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
