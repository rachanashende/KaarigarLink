// Shared generator + datasource. All *.prisma files in this folder are merged.
//   core.prisma   -> Member 1 (users, workshops, jobs, matching, invitations)
//   orders.prisma -> Member 2 (quotes, orders, milestones, QC, payments, ratings)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
