enum QuoteStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  /// Set by the system when the buyer cancels the job (not a workshop or buyer decision).
  CANCELLED
}

enum OrderStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  APPROVED
  REWORK_REQUIRED
}

enum InspectionStatus {
  PASSED
  FAILED
  REWORK_REQUIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Quote {
  id            String      @id @default(cuid())
  invitationId  String      @unique
  jobId         String
  workshopId    String
  totalPrice    Decimal     @db.Decimal(12, 2)
  currency      String      @default("INR")
  estimatedDays Int
  notes         String?     @db.Text
  validUntil    DateTime?
  status        QuoteStatus @default(SUBMITTED)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  invitation JobInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  job        Job           @relation(fields: [jobId], references: [id], onDelete: Restrict)
  workshop   Workshop      @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  order      Order?

  @@index([jobId, status])
  @@index([workshopId])
}

model Order {
  id                     String      @id @default(cuid())
  jobId                  String      @unique
  quoteId                String      @unique
  buyerId                String
  workshopId             String
  agreedPrice            Decimal     @db.Decimal(12, 2)
  currency               String      @default("INR")
  status                 OrderStatus @default(CONFIRMED)
  expectedCompletionDate DateTime?
  actualCompletionDate   DateTime?
  cancellationReason     String?     @db.Text
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  job         Job          @relation(fields: [jobId], references: [id], onDelete: Restrict)
  quote       Quote        @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  buyer       User         @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  workshop    Workshop     @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  milestones  Milestone[]
  inspections Inspection[]
  payments    Payment[]
  rating      Rating?
  inspectorAssignments InspectorAssignment[]
  inspectionDrafts     InspectionDraft[]
  documents            Document[]

  @@index([buyerId])
  @@index([workshopId])
  @@index([status])
}

model Milestone {
  id          String          @id @default(cuid())
  orderId     String
  title       String
  description String?         @db.Text
  sequence    Int
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inspections Inspection[]

  @@unique([orderId, sequence])
  @@index([orderId, status])
}

model Inspection {
  id          String           @id @default(cuid())
  orderId     String
  inspectorId String
  status      InspectionStatus
  findings    String?          @db.Text
  inspectedAt DateTime         @default(now())
  /// B2: the milestone a REWORK_REQUIRED inspection sent back (null otherwise).
  milestoneId String?
  /// M11: structured checklist results { version, items[], rework? }. Null for inspections recorded before M11.
  checklist   Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inspector User       @relation(fields: [inspectorId], references: [id], onDelete: Restrict)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  documents Document[]

  @@index([orderId])
  @@index([milestoneId])
  @@index([inspectorId])
}

/// Which inspector is responsible for an order's QC (B1). Rows are never deleted:
/// reassignment ends the current row (endedAt, endedById, active = null) and creates a new one.
/// `active` is true for the current assignment and NULL once ended, so the unique
/// (orderId, active) allows any number of ended rows but at most ONE active row per order.
model InspectorAssignment {
  id           String    @id @default(cuid())
  orderId      String
  inspectorId  String
  assignedById String
  assignedAt   DateTime  @default(now())
  active       Boolean?  @default(true)
  endedAt      DateTime?
  endedById    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  inspector  User  @relation("AssignedInspector", fields: [inspectorId], references: [id], onDelete: Restrict)
  assignedBy User  @relation("AssignmentCreatedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  endedBy    User? @relation("AssignmentEndedBy", fields: [endedById], references: [id], onDelete: Restrict)

  @@unique([orderId, active])
  @@index([inspectorId, active])
  @@index([orderId, assignedAt])
}

/// M11: an inspector's private, unsubmitted inspection for one order. Never an
/// official inspection: it changes no order, milestone or completion state. One per
/// (order, inspector); a reassigned inspector cannot read another inspector's draft.
/// Submitting an inspection deletes the submitter's draft in the same transaction.
model InspectionDraft {
  id          String   @id @default(cuid())
  orderId     String
  inspectorId String
  /// Same structure as Inspection.checklist.
  checklist   Json
  findings    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inspector User  @relation("InspectionDraftAuthor", fields: [inspectorId], references: [id], onDelete: Cascade)

  @@unique([orderId, inspectorId])
  @@index([inspectorId])
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("INR")
  status         PaymentStatus @default(PENDING)
  transactionRef String?       @unique
  description    String?
  paidAt         DateTime?
  /// B3: set by the explicit (simulated) refund of a SUCCEEDED payment on a CANCELLED order.
  refundedAt     DateTime?
  refundedById   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refundedBy User? @relation("PaymentRefundedBy", fields: [refundedById], references: [id], onDelete: Restrict)

  @@index([orderId, status])
}

model Rating {
  id         String   @id @default(cuid())
  orderId    String   @unique
  workshopId String
  buyerId    String
  score      Int
  review     String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  buyer    User     @relation("BuyerRatings", fields: [buyerId], references: [id], onDelete: Restrict)

  @@index([workshopId])
  @@index([buyerId])
}
