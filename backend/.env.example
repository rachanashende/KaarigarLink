# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=4000

# Local PostgreSQL 16 (service postgresql-x64-16, port 5432).
# Replace YOUR_PASSWORD with the postgres password set during install.
# Prisma creates the database automatically on first migrate if it does not exist.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/kaarigarlink_dev?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins: scheme://host[:port], no
# trailing slash. Optional in development: the default is the two local Vite
# frontends below (workshop app = localhost:5173, buyer app = 127.0.0.1:5173).
# If you run BOTH frontends at once, Vite moves the second to port 5174 - add
#   http://localhost:5174,http://127.0.0.1:5174
# REQUIRED when NODE_ENV=production (local production-mode run); "*" rejected.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BCRYPT_SALT_ROUNDS=10

# Password for every demo account created by `npm run db:seed` (8-72 chars).
# Choose your own and share it with teammates privately - never commit it.
SEED_DEFAULT_PASSWORD="choose-a-demo-password"
# Seeding refuses NODE_ENV=production unless this is "true" (demo deployments only).
# SEED_ALLOW_PRODUCTION=true

# --- Smoke test (npm run smoke) - only needed when you run it -----------------
# Writes one job + invitation per run: use a local demo/test database only.
# SMOKE_BASE_URL=http://localhost:4000
# SMOKE_BUYER_EMAIL=asha.rao@kaarigarlink.test
# SMOKE_BUYER_PASSWORD=
# SMOKE_WORKSHOP_EMAIL=precision-works@kaarigarlink.test
# SMOKE_WORKSHOP_PASSWORD=
# SMOKE_CONFIRM_WRITES=yes
