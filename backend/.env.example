# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=4000

# Local PostgreSQL 16 (service postgresql-x64-16, port 5432).
# Replace YOUR_PASSWORD with the postgres password set during install.
# Prisma creates the database automatically on first migrate if it does not exist.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/kaarigarlink_dev?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

BCRYPT_SALT_ROUNDS=10

# Password for every demo account created by `npm run db:seed` (8-72 chars).
# Choose your own and share it with teammates privately - never commit it.
SEED_DEFAULT_PASSWORD="choose-a-demo-password"
# Seeding refuses NODE_ENV=production unless this is "true" (demo deployments only).
# SEED_ALLOW_PRODUCTION=true
